{
  "transaction": {
    "obj_name": "repm_location",
    "sql_models": [
      {
        "sql_model": {
          "form_title": "Location Master",
          "form_descr": "Maintain project sites / locations used to tag projects.",
          "columns": [
            {
              "column": {
                "name": "LOC_ID",
                "group_name": "Basic",
                "col_type": "CHAR10",
                "heading": "Location ID",
                "descr": "Unique system identifier for location",
                "key": true,
                "default_value": "auto_generate()",
                "mandatory": "true",
                "hidden": "1"
              }
            },
            {
              "column": {
                "name": "LOC_CODE",
                "group_name": "Basic",
                "col_type": "CHAR10",
                "heading": "Location Code",
                "descr": "Unique location code",
                "mandatory": "true",
                "validations": ["expression('unique(LOC_CODE)','Location Code must be unique')"]
              }
            },
            {
              "column": {
                "name": "LOC_NAME",
                "group_name": "Basic",
                "col_type": "VARCHAR100",
                "heading": "Location Name",
                "descr": "Name of the location",
                "mandatory": "true"
              }
            },
            {
              "column": {
                "name": "ADDR_LINE1",
                "group_name": "Address",
                "col_type": "VARCHAR120",
                "heading": "Address Line 1",
                "descr": "Address line 1",
                "mandatory": "true"
              }
            },
            {
              "column": {
                "name": "ADDR_LINE2",
                "group_name": "Address",
                "col_type": "VARCHAR120",
                "heading": "Address Line 2",
                "descr": "Address line 2"
              }
            },
            {
              "column": {
                "name": "CITY",
                "group_name": "Address",
                "col_type": "VARCHAR60",
                "heading": "City",
                "descr": "City name",
                "mandatory": "true"
              }
            },
            {
              "column": {
                "name": "STATE",
                "group_name": "Address",
                "col_type": "VARCHAR40",
                "heading": "State",
                "descr": "Indian state",
                "mandatory": "true",
                "edit_mask": {"mask": "ddlb", "values": [
                  {"data": "AN", "display": "Andaman and Nicobar Islands"},
                  {"data": "AP", "display": "Andhra Pradesh"},
                  {"data": "AR", "display": "Arunachal Pradesh"},
                  {"data": "AS", "display": "Assam"},
                  {"data": "BR", "display": "Bihar"},
                  {"data": "CH", "display": "Chandigarh"},
                  {"data": "CT", "display": "Chhattisgarh"},
                  {"data": "DN", "display": "Dadra and Nagar Haveli and Daman and Diu"},
                  {"data": "DL", "display": "Delhi"},
                  {"data": "GA", "display": "Goa"},
                  {"data": "GJ", "display": "Gujarat"},
                  {"data": "HR", "display": "Haryana"},
                  {"data": "HP", "display": "Himachal Pradesh"},
                  {"data": "JK", "display": "Jammu and Kashmir"},
                  {"data": "JH", "display": "Jharkhand"},
                  {"data": "KA", "display": "Karnataka"},
                  {"data": "KL", "display": "Kerala"},
                  {"data": "LA", "display": "Ladakh"},
                  {"data": "LD", "display": "Lakshadweep"},
                  {"data": "MP", "display": "Madhya Pradesh"},
                  {"data": "MH", "display": "Maharashtra"},
                  {"data": "MN", "display": "Manipur"},
                  {"data": "ML", "display": "Meghalaya"},
                  {"data": "MZ", "display": "Mizoram"},
                  {"data": "NL", "display": "Nagaland"},
                  {"data": "OR", "display": "Odisha"},
                  {"data": "PY", "display": "Puducherry"},
                  {"data": "PB", "display": "Punjab"},
                  {"data": "RJ", "display": "Rajasthan"},
                  {"data": "SK", "display": "Sikkim"},
                  {"data": "TN", "display": "Tamil Nadu"},
                  {"data": "TG", "display": "Telangana"},
                  {"data": "TR", "display": "Tripura"},
                  {"data": "UP", "display": "Uttar Pradesh"},
                  {"data": "UT", "display": "Uttarakhand"},
                  {"data": "WB", "display": "West Bengal"}
                ]}
              }
            },
            {
              "column": {
                "name": "PIN_CODE",
                "group_name": "Address",
                "col_type": "CHAR6",
                "heading": "Pin Code",
                "descr": "6-digit numeric pin code",
                "mandatory": "true",
                "validations": ["expression('length(PIN_CODE)=6 and is_numeric(PIN_CODE)','Pin Code must be 6 digits numeric')"]
              }
            },
            {
              "column": {
                "name": "COUNTRY",
                "group_name": "Address",
                "col_type": "VARCHAR40",
                "heading": "Country",
                "descr": "Country name",
                "default_value": "India",
                "mandatory": "true"
              }
            },
            {
              "column": {
                "name": "LATITUDE",
                "group_name": "Geo",
                "col_type": "NUMBER(9,6)",
                "heading": "Latitude",
                "descr": "Latitude coordinate",
                "validations": ["expression('LATITUDE between -90 and 90','Latitude must be between -90 and 90')"]
              }
            },
            {
              "column": {
                "name": "LONGITUDE",
                "group_name": "Geo",
                "col_type": "NUMBER(9,6)",
                "heading": "Longitude",
                "descr": "Longitude coordinate",
                "validations": ["expression('LONGITUDE between -180 and 180','Longitude must be between -180 and 180')"]
              }
            },
            {
              "column": {
                "name": "STATUS",
                "group_name": "Basic",
                "col_type": "CHAR1",
                "heading": "Status",
                "descr": "Active/Inactive status",
                "default_value": "A",
                "mandatory": "true",
                "edit_mask": {"mask": "ddlb", "values": [
                  {"data": "A", "display": "Active"},
                  {"data": "I", "display": "Inactive"}
                ]}
              }
            },
            {
              "column": {
                "name": "ADD_DATE",
                "group_name": "Audit",
                "col_type": "DATETIME",
                "heading": "Added On",
                "descr": "Record creation timestamp",
                "default_value": "now()",
                "protect": "1"
              }
            },
            {
              "column": {
                "name": "ADD_USER",
                "group_name": "Audit",
                "col_type": "CHAR10",
                "heading": "Added By",
                "descr": "User who created the record",
                "default_value": "logged_in_user()",
                "protect": "1"
              }
            },
            {
              "column": {
                "name": "ADD_TERM",
                "group_name": "Audit",
                "col_type": "VARCHAR15",
                "heading": "Added Term",
                "descr": "Terminal that created the record",
                "default_value": "logged_in_terminal()",
                "protect": "1"
              }
            },
            {
              "column": {
                "name": "CHG_DATE",
                "group_name": "Audit",
                "col_type": "DATETIME",
                "heading": "Changed On",
                "descr": "Record last change timestamp",
                "default_value": "now()",
                "protect": "1"
              }
            },
            {
              "column": {
                "name": "CHG_USER",
                "group_name": "Audit",
                "col_type": "CHAR10",
                "heading": "Changed By",
                "descr": "User who last changed the record",
                "default_value": "logged_in_user()",
                "protect": "1"
              }
            },
            {
              "column": {
                "name": "CHG_TERM",
                "group_name": "Audit",
                "col_type": "VARCHAR15",
                "heading": "Changed Term",
                "descr": "Terminal that last changed the record",
                "default_value": "logged_in_terminal()",
                "protect": "1"
              }
            }
          ],
          "joins": {
            "join_predicates": {
              "joins": [
                {
                  "table": "REPM_LOCATION",
                  "main_table": true,
                  "table_descr": "Project location master"
                }
              ]
            }
          },
          "validations": [
            "expression('unique(LOC_CODE)','Location Code must be unique')",
            "business_logic('validate_location','Validate pin code, lat/lng ranges and uniqueness of code')"
          ]
        }
      }
    ],
    "actions": [
      "add",
      "edit",
      "delete",
      "search"
    ],
    "cross_updates": [],
    "attach_docs": ["Location Reference Document"],
    "follow_up_actions": []
  }
}
