      "approve:business_logic('approve_project','Set Status to Planned, stamp APPR_DT and APPR_USER, validate budget tolerance')",
      "cancel:business_logic('cancel_project','Set Status to Cancelled, stamp CANCEL_DT, cascade-cancel all open phases, tasks, activities and action points')"
    ],
    "cross_updates": [
      "business_logic('cascade_cancel_children','On Cancel, cascade-cancel all open phases, tasks, activities and action points belonging to this project')",
      "business_logic('recompute_project_progress','Recompute project % complete from phase weightages whenever phase status or % complete changes')"
    ],
    "attach_docs": [
      "Project Charter",
      "RERA Certificate",
      "Approval Letter",
      "Layout Plan",
      "Budget Sheet"
    ],
    "follow_up_actions": [
      "on-submit_for_approval,notify_approver:email(get_role('approver'),'project_submit_for_approval','Project Code, Name, Estimated Budget, Approved Budget, Project Manager, Planned dates and submission details')",
      "on-approve,notify_pm:email(get_role('project_manager'),'project_approved','Project approved with stamped approval date and user; status set to Planned')",
      "on-cancel,notify_stakeholders:email(get_role('project_manager'),'project_cancelled','Project cancelled; all open child phases/tasks/activities/action points cascade-cancelled')",
      "on-add-edit,refresh_progress:business_logic('refresh_progress_rollup','Recompute % complete rollup from child phases')"
    ]
