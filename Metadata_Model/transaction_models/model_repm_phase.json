    "follow_up_actions": [
      "on-cancel,trigger_email:email(get_role('project_manager'),'phase_cancelled','Phase has been cancelled and child tasks are being cancelled')",
      "on-complete,trigger_email:email(get_role('project_manager'),'phase_completed','Phase has been completed; project % complete has been recomputed')"
    ]
  }
