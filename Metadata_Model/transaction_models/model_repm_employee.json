    "cross_updates": [
      {
        "mode": "business_logic",
        "business_logic": {
          "method": "block_new_assignments",
          "description": "Prevent deactivation with open action points",
          "spec": "When the employee STATUS in the payload is 'I' and the currently stored STATUS in REPM_EMPLOYEE is 'A' (i.e. being deactivated), query REPM_ACTION_POINT for rows where ASSIGNED_EMP_CODE = EMP_CODE and STATUS IN ('PE','IP'). If any such rows exist, return {\"error\": \"Cannot deactivate: <N> open action point(s) are still assigned. Please reassign them before deactivating.\"} to block the save. Otherwise return NULL."
        }
      },
      {
        "mode": "business_logic",
        "business_logic": {
          "method": "flag_open_action_points",
          "description": "Flag blocked action points on deactivation",
          "spec": "When the employee STATUS in the payload is 'I' and the currently stored STATUS in REPM_EMPLOYEE is 'A' (i.e. being deactivated), update REPM_ACTION_POINT.REMARKS for all rows where ASSIGNED_EMP_CODE = EMP_CODE and STATUS = 'BL' (Blocked) by appending ' | [Needs Reassignment: Employee deactivated on <today date>]'. Return NULL."
        }
      }
    ],
