                    "type": "expression",
                    "name": "Email format",
                    "message": "Email must be a valid format (must contain @ and domain)",
                    "expression": "contains({form.EMAIL}, '@') and contains({form.EMAIL}, '.') and len(trim({form.EMAIL})) >= 5"
                  },
                  {
                    "type": "builtin",
                    "name": "Email unique",
                    "message": "Email must be unique across all employees",
