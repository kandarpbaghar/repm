                "validations": "",
                "lookup": ""
              }
            }
          ],
          "joins": {
            "join_predicates": {
              "joins": [
                {
                  "table": "REPM_ACTION_POINT",
                  "main_table": true,
                  "table_descr": "Action point main table"
                },
                {
                  "table": "REPM_PROJECT",
                  "main_table": false,
                  "table_descr": "Project master (lookup)",
                  "column": "PROJ_CODE",
                  "join_table": "REPM_ACTION_POINT",
                  "join_column": "PROJ_CODE",
                  "join_type": "inner"
                },
                {
                  "table": "REPM_PHASE",
                  "main_table": false,
                  "table_descr": "Phase master (lookup)",
                  "column": "PHASE_ID",
                  "join_table": "REPM_ACTION_POINT",
                  "join_column": "PHASE_ID",
                  "join_type": "inner"
                },
                {
                  "table": "REPM_TASK",
                  "main_table": false,
                  "table_descr": "Task master (lookup)",
                  "column": "TASK_ID",
                  "join_table": "REPM_ACTION_POINT",
                  "join_column": "TASK_ID",
                  "join_type": "inner"
                },
                {
                  "table": "REPM_ACTIVITY",
                  "main_table": false,
                  "table_descr": "Activity master (lookup)",
                  "column": "ACTIVITY_ID",
                  "join_table": "REPM_ACTION_POINT",
                  "join_column": "ACTIVITY_ID",
                  "join_type": "inner"
                },
                {
                  "table": "REPM_EMPLOYEE",
                  "main_table": false,
                  "table_descr": "Employee master (lookup for assignee)",
                  "column": "EMP_CODE",
                  "join_table": "REPM_ACTION_POINT",
                  "join_column": "ASSIGNED_EMP_CODE",
                  "join_type": "inner"
                }
              ]
            }
          },
          "validations": [
            "expression('STATUS != \"DN\" or COMPLETED_DT is not null')",
            "expression('STATUS != \"BL\" or BLOCKING_REASON is not null')",
            "business_logic('validate_due_date_range','Due Date must be within parent activity planned start and end dates')",
            "business_logic('validate_seq_unique','Action Point Sequence must be unique within Activity')"
          ],
          "form_no": "1"
        }
      }
    ],
    "actions": [
      "add",
      "edit",
      "delete",
      "search",
      "mark_done:business_logic('mark_action_done','Set STATUS=DN, stamp COMPLETED_DT=today() and trigger roll-up')",
      "mark_blocked:business_logic('mark_action_blocked','Set STATUS=BL, require BLOCKING_REASON and notify')",
      "cancel:business_logic('cancel_action_point','Set STATUS=CN; excluded from progress computation')"
    ],
    "cross_updates": [
      "business_logic('recompute_activity_pct','Recompute parent activity % complete from Done vs non-cancelled action points')",
      "business_logic('rollup_task_phase_project','Roll-up % complete to task, phase and project using weightages')"
    ],
    "attach_docs": [
      "Action Point Attachment",
      "Supporting Document"
    ],
    "follow_up_actions": [
      "on-mark_done,trigger_email:email(get_activity_owner(ACTIVITY_ID),'action_point_done','Action point #SEQ_NO under activity #ACTIVITY_NAME marked Done by #CHG_USER on #COMPLETED_DT')",
      "on-mark_blocked,trigger_email:email(get_task_owner(TASK_ID),'action_point_blocked','Action point #SEQ_NO blocked. Reason: #BLOCKING_REASON')",
      "on-mark_blocked,trigger_email:email(get_project_manager(PROJ_CODE),'action_point_blocked_pm','Action point #SEQ_NO under #PROJ_CODE blocked. Reason: #BLOCKING_REASON')",
      "on-add-edit-mark_done-mark_blocked-cancel,business_logic('recompute_progress_rollup','Recompute activity/task/phase/project % complete')"
    ]
  }
}